# ==========================================
# SANCHARI BACKEND ENVIRONMENT (.env.example)
# Copy this to .env and fill in real values. Never commit the real .env.
# ==========================================

# Server Configuration
PORT=3001
NODE_ENV=development

# AI Engine (Groq Cloud API Key)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Supabase Configuration
# Get these at: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Redis Configuration (Upstash or Local)
# Get a free cloud Redis database at: https://upstash.com
REDIS_URL=

# Foursquare Places API (Get free API key at: https://foursquare.com/developers)
FOURSQUARE_API_KEY=

GOOGLE_MAPS_API_KEY=

# Pexels API (Get free key at: https://www.pexels.com/api/)
PEXELS_API_KEY=
